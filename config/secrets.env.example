# Copy to config/secrets.env (or one file per account, e.g.
# config/profiles/<name>/secrets.env) and run: chmod 600 <file>
# Never commit the real file; it is gitignored.
#
# Point the tools at it with --secrets <file> or SAARTHI_SECRETS=<file>.
# Real environment variables override values in the file.

# Angel One SmartAPI (smartapi.angelone.in > My Apps)
ANGEL_API_KEY=
# Your Angel One client ID, e.g. A123456
ANGEL_CLIENT_CODE=
# 4-digit MPIN used to log in
ANGEL_MPIN=
# Base32 text shown under the QR code on smartapi.angelone.in/enable-totp
ANGEL_TOTP_SECRET=

# Telegram reports (M5): token from @BotFather, chat id of the recipient
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude strategist (M4)
ANTHROPIC_API_KEY=

# Bearer token for the localhost control API (M4): openssl rand -hex 32
CONTROL_API_TOKEN=
