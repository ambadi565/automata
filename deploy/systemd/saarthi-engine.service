[Unit]
Description=Saarthi trading engine (paper until go-live)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
OnFailure=saarthi-alert@%n.service
# A crash loop must not hammer the broker: at most 20 starts in 6 hours.
StartLimitIntervalSec=6h
StartLimitBurst=20

[Service]
Type=simple
User=saarthi
Group=saarthi
WorkingDirectory=/opt/saarthi
Environment=SAARTHI_MODE=paper
Environment=SAARTHI_LOG_JSON=1
# Boot checks first: a holiday exits 0 (nothing to do); a bad disk, clock or
# secrets file exits 78, alerts, and is not retried.
ExecStart=/bin/sh -c '/opt/saarthi/target/release/engine preflight && exec /opt/saarthi/target/release/engine run'
# A normal exit (holiday, or flat after 15:35) is final; a crash restarts and recovers from SQLite + the broker.
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/saarthi/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=2G

[Install]
WantedBy=multi-user.target
